{
  "name": "kip-31-core",
  "version": "1.0.0",
  "description": "Core testing framework for KIP-31 project",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules ./node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/.bin/jest --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["testing", "jest", "kip-31"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "transform": {
      "^.+\\.m?js$": "babel-jest"
    },
    "extensionsToTreatAsEsm": [".js", ".mjs"],
    "collectCoverage": true,
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "babel": {
    "presets": [
      ["@babel/preset-env", {
        "targets": {
          "node": "current"
        }
      }]
    ]
  }
}